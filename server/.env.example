# ============================================================
# SOFOL backend environment  →  copy to server/.env and fill in
# ============================================================
# NEVER commit server/.env (it is git-ignored). Only this .example
# file, with placeholder values, belongs in version control.

# ---- Supabase (Project Settings → API) ----
# Public REST/Auth URL for your project.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# SECRET. Server-only key that bypasses Row Level Security. Never expose
# this to the Expo frontend. Used by server/src/config/supabase.ts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional. Public anon key. The server currently authenticates with the
# service-role client; kept here for future least-privilege use.
SUPABASE_ANON_KEY=your-anon-key

# ---- HTTP server ----
PORT=3000

# ---- Seed admin account ----
# The admin auth module bootstraps this account on first login. Change the
# password from the default before any real deployment.
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=123456

# ---- Security middleware (Milestone 8) ----
# Comma-separated CORS allow-list. Empty falls back to Expo dev origins
# (localhost:8081/19006, 127.0.0.1:8081, exp://localhost:19000). Production
# MUST set its real client origins here.
CORS_ORIGINS=http://localhost:8081

# Rate limits (per-IP, 15-minute window). Defaults if unset:
#   RATE_LIMIT_AUTH_MAX=100          (login/register/reset-password)
#   RATE_LIMIT_ADMIN_MUTATION_MAX=60 (admin officer/status mutations)
# Raise locally when running the full E2E battery back-to-back.
#RATE_LIMIT_AUTH_MAX=300
#RATE_LIMIT_ADMIN_MUTATION_MAX=300
