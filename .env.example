# ============================================================
# SOFOL frontend (Expo) environment → copy to .env and fill in
# ============================================================
# Only this .example file, with placeholder values, belongs in
# version control. Never commit a real .env.

# ---- API base URL (optional) ----
# Where the Expo app finds the SOFOL backend. Expo inlines EXPO_PUBLIC_*
# variables at build time. When unset the API client falls back to
# http://10.0.2.2:3000 on Android emulators (host loopback alias) and
# http://localhost:3000 everywhere else (iOS simulator / web).
# Set this only when running on a physical device against a machine on
# your LAN, e.g. http://192.168.1.10:3000
EXPO_PUBLIC_API_URL=http://localhost:3000
